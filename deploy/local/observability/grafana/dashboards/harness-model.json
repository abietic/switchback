{
  "uid": "sb-harness-model",
  "title": "Harness & Model",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "switchback",
    "local"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "AgentTurn terminal rows (absolute gauges)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "switchback-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "switchback_agent_turn_terminal",
          "legendFormat": "{{status}} {{harness}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Retained WorkerRun duration mean (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "switchback-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (harness) (switchback_worker_run_duration_seconds_sum) / sum by (harness) (switchback_worker_run_duration_seconds_count)",
          "legendFormat": "{{status}} {{harness}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Retained AgentTurn duration mean (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "switchback-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (harness) (switchback_agent_turn_duration_seconds_sum) / sum by (harness) (switchback_agent_turn_duration_seconds_count)",
          "legendFormat": "{{status}} {{harness}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Model canonical measurement coverage (0 = unavailable)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "switchback-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "switchback_model_measurement_available",
          "legendFormat": "{{status}} {{harness}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 100,
      "type": "text",
      "title": "Evidence boundary",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "TTFT, model cost and token usage are **unavailable**: no canonical complete measurement exists. Availability=0 does not mean zero cost, zero tokens or success. Harness is verified agent identity, not model vendor."
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Safe run ID (optional; Backend lifecycle events currently lack it)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "links": [
    {
      "title": "Backend safe lifecycle logs",
      "type": "link",
      "targetBlank": true,
      "url": "/explore?schemaVersion=1&panes=%7B%22local%22%3A%7B%22datasource%22%3A%22switchback-loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bservice%3D%5C%22switchback-backend%5C%22%2Cenvironment%3D%5C%22local%5C%22}%20%7C%20json%22%2C%22queryType%22%3A%22range%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22switchback-loki%22}}%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22}}}"
    },
    {
      "title": "Explore exact safe run ID",
      "type": "link",
      "targetBlank": true,
      "url": "/explore?schemaVersion=1&panes=%7B%22local%22%3A%7B%22datasource%22%3A%22switchback-loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bservice%3D%5C%22switchback-backend%5C%22%2Cenvironment%3D%5C%22local%5C%22}%20%7C%20json%20run_id%3D%5C%22scope.worker_run_id%5C%22%20%7C%20run_id%20%3D%20%5C%22${run_id}%5C%22%22%2C%22queryType%22%3A%22range%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22switchback-loki%22}}%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22}}}"
    }
  ]
}
