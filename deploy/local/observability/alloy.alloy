logging {
  level = "warn"
}
loki.source.api "backend" {
  http {
    listen_address = "0.0.0.0"
    listen_port = 12345
  }
  use_incoming_timestamp = true
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  max_streams = 64
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
    name = "local"
    batch_size = "256KiB"
    batch_wait = "1s"
    remote_timeout = "2s"
    min_backoff_period = "100ms"
    max_backoff_period = "500ms"
    max_backoff_retries = 2
    follow_redirects = false
    queue_config {
      capacity = "1MiB"
      min_shards = 1
      block_on_overflow = false
      drain_timeout = "3s"
    }
  }
}
