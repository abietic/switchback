# UNDEPLOYED new candidate template; no pre-exec final digest expansion.
# Retain the guest-global mount namespace for frozen qualification identity.
[Unit]
Description=Switchback created-layer observer (qualification bootstrap candidate)

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/switchback/bin/switchback-created-layer-observer serve-installed
RuntimeDirectory=switchback-created-layer
RuntimeDirectoryMode=0700
Slice=switchback-core.slice
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
SystemCallFilter=~@mount @reboot @swap
Restart=no
UMask=0077
CPUQuota=20%
CPUQuotaPeriodSec=100ms
MemoryMax=128M
MemorySwapMax=0
TasksMax=64
KillMode=control-group
TimeoutStopSec=10s
