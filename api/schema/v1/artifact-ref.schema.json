{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://switchback.local/schema/v1/artifact-ref.schema.json",
  "title": "Switchback ArtifactRef v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","artifact_id","tenant_id","user_id","workspace_id","task_id","worker_session_id","worker_run_id","agent_turn_id","runtime_instance_id","runtime_generation","type","uri","sha256","size_bytes","permission","retention_policy_ref","storage_tier","availability","completeness","completeness_reason","source_checkpoint_ref","available_actions","created_at"],
  "properties": {
    "schema_version": {"const":"artifact.v1"},
    "artifact_id": {"type":"string","minLength":1},
    "tenant_id": {"type":"string","minLength":1},
    "user_id": {"type":"string","minLength":1},
    "workspace_id": {"type":"string","minLength":1},
    "task_id": {"type":"string"},
    "worker_session_id": {"type":"string","minLength":1},
    "worker_run_id": {"type":"string","minLength":1},
    "agent_turn_id": {"type":"string","minLength":1},
    "runtime_instance_id": {"type":"string","minLength":1},
    "runtime_generation": {"type":"integer","minimum":1},
    "type": {"enum":["report","patch"]},
    "uri": {"type":"string","minLength":1},
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "size_bytes": {"type":"integer","minimum":0},
    "permission": {"type":"object"},
    "retention_policy_ref": {"type":"string","minLength":1},
    "storage_tier": {"enum":["hot","warm","cold"]},
    "availability": {"enum":["online","restoring","quarantined","deletion_pending","deleted","error"]},
    "completeness": {"enum":["complete","partial"]},
    "completeness_reason": {"type":"string"},
    "source_checkpoint_ref": {"type":"object"},
    "available_actions": {"type":"array","minItems":1,"items":{"type":"string"}},
    "created_at": {"type":"string","format":"date-time"}
  }
}
