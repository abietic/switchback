{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://switchback.local/schema/v1/assistant-conversation-command.schema.json",
  "title": "Switchback Assistant Conversation Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","command_type","conversation_id","expected_revision","idempotency_key","content","assistant_run_id","assistant_run_revision","workspace_id","workspace_revision_id","workspace_resolution_id","workspace_resolution_revision","membership_revision","checkpoint_id","checkpoint_revision","checkpoint_action","task_draft_id","task_draft_revision","readiness_assessment_id","readiness_assessment_revision","task_spec_digest","trigger_policy_revision"],
  "properties": {
    "schema_version":{"const":"assistant.conversation_command.v1"},
    "command_type":{"enum":["create_conversation","open_conversation","send_message","select_workspace","checkpoint_action","confirm_task","cancel_run","retry_run"]},
    "conversation_id":{"type":"string"},
    "expected_revision":{"type":"integer","minimum":0},
    "idempotency_key":{"type":"string","minLength":1},
    "content":{"type":"string"},
    "assistant_run_id":{"type":"string"},
    "assistant_run_revision":{"type":"integer","minimum":0},
    "workspace_id":{"type":"string"},
    "workspace_revision_id":{"type":"string"},
    "workspace_resolution_id":{"type":"string"},
    "workspace_resolution_revision":{"type":"integer","minimum":0},
    "membership_revision":{"type":"integer","minimum":0},
    "checkpoint_id":{"type":"string"},
    "checkpoint_revision":{"type":"integer","minimum":0},
    "checkpoint_action":{"type":"string"},
    "task_draft_id":{"type":"string"},
    "task_draft_revision":{"type":"integer","minimum":0},
    "readiness_assessment_id":{"type":"string"},
    "readiness_assessment_revision":{"type":"integer","minimum":0},
    "task_spec_digest":{"type":"string"},
    "trigger_policy_revision":{"type":"string"}
  }
}
