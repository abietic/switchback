#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export PYTHONDONTWRITEBYTECODE=1
python3 scripts/test-python-runner
for suite in deploy/experience/engine test/acceptance/experienceprepare test/acceptance/experiencefreeze images/worker/litellm; do
  python3 scripts/run-python-suite.py "$suite"
done
