#!/bin/sh
set -eu
# Token boundaries avoid the suffix of identifiers such as Task-; generic keys
# are contiguous alphanumeric tokens, so deterministic hyphenated labels pass.
patterns='(^|[^A-Za-z0-9_])(sk-(live|prod|kimi)-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{20,})([^A-Za-z0-9_]|$)|AKIA[0-9A-Z]{16}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----'
status=0
# Only Git metadata is excluded. No source or fixture directory is exempt.
rg -l --hidden --no-ignore --glob '!.git/**' -- "$patterns" . 2>/dev/null || status=$?
case "$status" in
  0) printf '%s\n' 'possible credential found in the working tree' >&2; exit 1 ;;
  1) exit 0 ;;
  *) printf '%s\n' 'credential scan failed' >&2; exit 1 ;;
esac
