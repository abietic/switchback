#!/usr/bin/env bash
set -euo pipefail
scanner=$(cd "$(dirname "$0")" && pwd)/check-secrets
fixtures=$(mktemp -d "${TMPDIR:-/tmp}/switchback-secrets.XXXXXX")
trap 'rm -rf "$fixtures"' EXIT
count=0
check() {
  local expected=$1 value=$2
  printf '%s\n' "$value" > "$fixtures/input.txt"
  local status=0
  (cd "$fixtures" && "$scanner") > "$fixtures/../$(basename "$fixtures").out" 2>&1 || status=$?
  local output="$fixtures/../$(basename "$fixtures").out"
  if [[ "$status" != "$expected" ]]; then echo "secret characterization status mismatch" >&2; exit 1; fi
  if [[ "$expected" == 1 ]]; then
    if rg -F -- "$value" "$output" >/dev/null; then echo 'scanner leaked matched value' >&2; exit 1; fi
    rg -F 'possible credential' "$output" >/dev/null
  fi
  rm -f "$output"
  count=$((count+1))
}
check 0 'safe content'
check 0 'sk-example'
check 0 "Task-$(printf 'a%.0s' {1..32})"
check 0 'sk-deterministic-fixture-label-with-hyphens'
for prefix in '' live- prod- kimi-; do check 1 "$(printf 's%s%s' 'k-' "$prefix")$(printf 'a%.0s' {1..32})"; done
check 1 "$(printf 'AK%s' IA)$(printf 'A%.0s' {1..16})"
check 1 "$(printf '%s%s' '-----BEGIN RSA ' 'PRIVATE KEY-----')"
printf '%s\n' 'safe' > "$fixtures/input.txt"
mkdir "$fixtures/bin"
printf '%s\n' '#!/bin/sh' 'exit 2' > "$fixtures/bin/rg"
chmod +x "$fixtures/bin/rg"
if (cd "$fixtures" && PATH="$fixtures/bin:$PATH" "$scanner") > "$fixtures/error.out" 2>&1; then echo 'rg error accepted' >&2; exit 1; fi
rg -F 'credential scan failed' "$fixtures/error.out" >/dev/null
printf 'secret scanner characterization passed (%s cases plus rg error)\n' "$count"
