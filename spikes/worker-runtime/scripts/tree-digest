#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || ! -d "$1" ]]; then
	echo "usage: $0 DIRECTORY" >&2
	exit 2
fi

root="$(cd "$1" && pwd)"
(
	cd "$root"
	find . -type f -print0 | LC_ALL=C sort -z | while IFS= read -r -d '' path; do
		shasum -a 256 "$path"
	done
) | shasum -a 256 | awk '{print $1}'
