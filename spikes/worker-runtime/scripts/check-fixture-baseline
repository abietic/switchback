#!/usr/bin/env bash
set -euo pipefail

fixture_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../fixtures/go-repository" && pwd)"
output_file="$(mktemp)"
trap 'rm -f "$output_file"' EXIT

if (cd "$fixture_dir" && go test ./...) >"$output_file" 2>&1; then
	echo "fixture baseline unexpectedly passed" >&2
	cat "$output_file" >&2
	exit 1
fi

if ! grep -Fq "want 5" "$output_file"; then
	echo "fixture baseline failed without the expected defect" >&2
	cat "$output_file" >&2
	exit 1
fi
